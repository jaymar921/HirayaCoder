# --- HirayaCoder — local AI agent data (never commit) ---
.hirayacoder/
.hirayacoder/memory/
.hirayacoder/context-files/
.hirayacoder/tmp/
.hirayacoder/audit.log
.hirayacoder/outcomes.jsonl
*.hirayacoder.tmp

.ignore/

# --- Node / build ---
node_modules/
out/
dist/
*.vsix
npm-debug.log*

# --- Versioned packaged builds (binaries) — keep the folder's own README, ignore everything else ---
# Note: a nested `!/builds/**/README.md` would have no effect. Git does not descend
# into a directory excluded by `/builds/*`, so a negation cannot re-include a file
# inside it. Only this folder's own README is tracked; version folders are pure output.
/builds/*
!/builds/README.md

# --- Editor / OS ---
.vscode-test/
.DS_Store
Thumbs.db

# --- Env / secrets ---
.env
.env.*
*.pem
